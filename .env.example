APP_NAME="Employee Assistant"
APP_ENV="development"
DEBUG=True

# Generate a new one using: openssl rand -hex 32
SECRET_KEY="your-secret-key-here"

# Database: postgresql+asyncpg://user:pass@host:port/dbname
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/employee_assistant"

# LLM API Keys
XAI_API_KEY=""
GOOGLE_API_KEY=""
OPENAI_API_KEY=""
OPENAI_VERIFY_SSL=true

# LangSmith (Optional)
LANGCHAIN_TRACING_V2=false
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=""
LANGSMITH_PROJECT="EmployeeAssistant"

# Redis (Optional, used for rate limiting)
REDIS_URL="redis://localhost:6379/0"

# Power Automate Webhook for sending emails
POWER_AUTOMATE_WEBHOOK_URL=""

# CORS for frontend
ALLOWED_ORIGINS=["http://localhost:3000"]
