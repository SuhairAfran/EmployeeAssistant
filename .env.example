# ── App Settings ─────────────────────────────────────────
APP_NAME="Employee Assistant"
APP_ENV="development"
DEBUG=True
# Generate with: openssl rand -hex 32
SECRET_KEY="your-super-secret-hex-key-here"

# ── Database ─────────────────────────────────────────────
# MUST use postgresql+asyncpg:// for the driver
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/copilot_db"

# ── Redis (Optional - used for rate limiting) ────────────
REDIS_URL="redis://localhost:6379/0"

# ── LLM Providers ────────────────────────────────────────
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY=""  # Optional: used if you switch agents to Claude

# ── Observability (Optional but Recommended) ────────────
# Get your key at smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="enterprise-ai-copilot"

# ── Integrations ─────────────────────────────────────────
# Power Automate Webhook for sending emails
POWER_AUTOMATE_WEBHOOK_URL=""
